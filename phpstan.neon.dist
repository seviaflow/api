includes:
  - vendor/larastan/larastan/extension.neon

parameters:
  paths:
    - src
    - config
    - routes
    - tests
  stubFiles:
    - tests/PHPStan/Stubs/Testable.stub.php
  level: 5
  treatPhpDocTypesAsCertain: false
  excludePaths:
    - tests/PHPStan/Stubs/TestResponse.stub.php
  ignoreErrors:
    -
      identifier: larastan.noEnvCallsOutsideOfConfig
      path: config/seviaflow-api.php
  tmpDir: var/phpstan
