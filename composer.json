{
    "name": "seviaflow/api",
    "description": "SeviaFlow headless REST and OpenAPI adapter.",
    "type": "library",
    "homepage": "https://github.com/seviaflow/api",
    "license": "proprietary",
    "support": {
        "issues": "https://github.com/seviaflow/api/issues",
        "source": "https://github.com/seviaflow/api"
    },
    "require": {
        "php": "^8.2",
        "seviaflow/core": "^0.1@dev",
        "seviaflow/licensing": "^0.1@dev",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
    "larastan/larastan": "^3.10",
        "laravel/pint": "^1.17",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.36|^3.7",
        "pestphp/pest-plugin-laravel": "^2.4|^3.2"
    },
    "autoload": {
        "psr-4": {
            "SeviaFlow\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "format:test": "pint --test",
        "analyse": "phpstan analyse --debug --no-progress",
        "check": [
            "@format:test",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "SeviaFlow\\Api\\SeviaFlowApiServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
